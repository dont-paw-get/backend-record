# 기본 OCR 공급자 ("clova" 또는 "bedrock")
OCR_PROVIDER=clova

# AWS Bedrock 설정
AWS_PROFILE=kosa-mfa
AWS_REGION=us-east-1
BEDROCK_OCR_MODEL_ID=qwen.qwen3-vl-235b-a22b
