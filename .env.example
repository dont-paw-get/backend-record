# 애플리케이션 환경 설정
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8002

# PostgreSQL 데이터베이스 연결 URL (선택, 과거 migration history를 로컬에서 다룰 때만 필요)
DATABASE_URL=postgresql+psycopg://record_user:record_password@localhost:5433/dont_paw_get_record

# AWS Bedrock 설정 (OCR Provider)
AWS_PROFILE=kosa-mfa
AWS_REGION=us-east-1
BEDROCK_OCR_MODEL_ID=qwen.qwen3-vl-235b-a22b

# 관찰성 (OpenTelemetry) — 선택.
# OTEL_EXPORTER_OTLP_ENDPOINT 를 설정하면 트레이싱 exporter 가 활성화된다.
# 값이 없으면 트레이싱은 no-op 이며 앱은 정상 실행된다(로컬 기본값).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=backend-record
# OTEL_TRACES_SAMPLER_ARG=1.0
# LOG_LEVEL=INFO
