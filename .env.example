APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (선택, CLIAR-123 이후 배포 필수 아님. 과거 migration history를
# 로컬에서 다룰 때만 필요. 로컬 개발 기준: PostgreSQL, host port 5433, DB명 dont_paw_get_record)
DATABASE_URL=postgresql+psycopg://record_user:record_password@localhost:5433/dont_paw_get_record

# NAVER Cloud CLOVA OCR General API
# 실제 Invoke URL / Secret Key 값은 NAVER Cloud Console에서 발급받은 값으로
# 로컬 .env에만 채워주세요. 아래는 placeholder이며 실제 값이 아닙니다.
CLOVA_OCR_INVOKE_URL=https://example.apigw.ntruss.com/custom/v1/00000/xxxxxxxx/general
CLOVA_OCR_SECRET_KEY=your_clova_ocr_secret_key
